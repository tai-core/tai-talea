# The only thing the platform publishes: 8000 -> 30020.
#
# Everything behind it - Router on 8001, control plane on 8787, sglang on 9102 -
# stays inside the container. The two ports the platform *forces* open (9001 and
# 9002) have no listener at all, which is the whole reason the services were
# moved off them; see ../README.md §3.1.
#
# Rendered by cci-edge.sh from this template. Do not edit the rendered file:
# the next `up` overwrites it.

# Who may call the inference surface.
# `Bearer <key>` and a bare `<key>` are both accepted - the first is what OpenAI
# SDKs send, the second is what people type after reading a curl example.
# The key is long (48 hex chars); the default map_hash_bucket_size of 64 bytes
# cannot hold "Bearer <key>", so raise it explicitly.
map_hash_bucket_size 128;
map $http_authorization $talea_key_ok {
    default                  0;
    "Bearer __API_KEY__"     1;
    "__API_KEY__"            1;
}

# Rate limiting (plan P1-6). Both zones are per caller IP: the facade has one
# key for all callers, so the IP is the only dimension available at this layer.
# The request rate is deliberately generous - a streaming chat completion is
# one request regardless of how long it holds the connection - and the point
# is flood control, not metering. Applied at server level, so a 401 brute
# force is limited too: the `if` auth check finishes in the rewrite phase,
# before limit_req would run, so a location-level limit would never see
# unauthorized requests.
limit_req_zone  $binary_remote_addr zone=talea_api_req:10m  rate=20r/s;
limit_conn_zone $binary_remote_addr zone=talea_api_conn:10m;
limit_req_status  429;
limit_conn_status 429;

# Every auth failure lands in its own log: this is the brute-force signal,
# and `if=` conditional logging keeps it from being one line in a million.
map $status $talea_authfail {
    401      1;
    403      1;
    429      1;
    default  0;
}

server {
    listen 8000;
    server_name _;

    access_log /opt/tai-talea/logs/edge-access.log;
    # `if=` needs an explicit format name or nginx parses it as the format
    access_log /opt/tai-talea/logs/edge-authfail.log combined if=$talea_authfail;
    error_log  /opt/tai-talea/logs/edge-error.log warn;
    client_max_body_size 32m;

    # Flood control for everything the door serves, /health included: a
    # monitor polls at less than 1 r/s, so the limits below only ever bite
    # on abuse.
    limit_req  zone=talea_api_req  burst=40 nodelay;
    # limit_conn takes the bare zone name - no zone= prefix (that is limit_req syntax)
    limit_conn talea_api_conn 64;

    # Liveness without a key: a monitor should not need the secret, and this
    # path touches no model.
    location = /health {
        proxy_pass http://127.0.0.1:8001/health;
        proxy_read_timeout 10s;
    }

    # Inference. Buffering must be off or SSE arrives in one lump at the end.
    location /v1/ {
        if ($talea_key_ok = 0) {
            return 401;
        }
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Everything else - /metrics, /server_info, /workers, /state/*, and the
    # sglang admin endpoints - is not part of the contract. 403 distinguishes
    # "path not allowed" from "key missing" (401).
    location / {
        return 403;
    }
}
